# DeepFake Detection System — .gitignore

# Model Weights & Serialized Artifacts
*.pth
*.pt
*.bin
*.safetensors
*.ckpt
*.joblib
*.pkl
*.pickle
*.npz
*.h5
*.hdf5

# XGBoost model files
*.model
*.json.model

# Whisper/HuggingFace model directories
models/
Final-Vid/xgboost_fusion_model.joblib
Final-Vid/xgboost_fusion_model.json

# Dataset Files
# *.csv
# *.npy
# *.flac
# *.wav
# *.mp4
# *.avi
# *.mov
# *.mkv
# *.mp3
# *.jpg
# *.jpeg
# *.png
# *.bmp
# *.tiff
# *.webp

# Dataset directories
data/
datasets/
raw/
processed/
frames/
splits/

# Jupyter Notebook Output
# Uncomment below to strip notebook outputs (recommended for large notebooks)
# *.ipynb

# Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
pip-wheel-metadata/
*.pyo

# Environment & Secrets
.env
.env.local
.env.*.local
secrets.yaml
config_local.py
credentials.json

# Streamlit
.streamlit/

# Temporary Files & Caches
*.tmp
*.temp
/tmp/
temp/
cache/
.cache/
__pycache__/

# HuggingFace model cache
~/.cache/huggingface/
.huggingface/

# Kaggle
.kaggle/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs & Reports
*.log
logs/
Forensic_Reports/
artifacts_v2/
fusion_artifacts/

# Colab / Kaggle Working Dirs
/kaggle/
/content/

